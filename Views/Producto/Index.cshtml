@model List<TiendaVirtualReyes.Models.Producto>

<h2>Lista de Productos</h2>

@if (Context.Session.GetString("Rol") == "admin")
{
    <a class="btn btn-success mb-3" href="/Producto/Create">Nuevo Producto</a>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<a class="btn btn-primary mb-3" href="/Producto/Carrito"> Ver Carrito</a> 
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@item.ImagenUrl" class="card-img-top"
                     style="height: 200px; object-fit: cover;"
                     alt="@item.Nombre" />
                <div class="card-body">
                    <h5 class="card-title">@item.Nombre</h5>
                    <p class="card-text">
                        <strong>Precio:</strong> $@item.Precio <br />
                        <strong>Stock:</strong> @item.Stock <br />
                        <strong>Categoría:</strong> @item.Categoria?.Nombre
                    </p>
                </div>
                <hr>
                @if(item.Stock > 0)
                {
                    
                
                    <form asp-action="AgregarCarrito" method="post">

                        <input type="hidden" name="id" value="@item.Id" />

                        <input type="number"
                               name="cantidad"
                               value="1"
                               min="1"
                               max="@item.Stock"
                               class="form-control mb-2" />

                        <button class="btn btn-primary w-100">
                            Agregar al carrito
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning text-center">
                        Producto agotado
                    </div>

                    <button class="btn btn-secondary w-100" disabled>
                        Sin stock
                    </button>
                }
                @if (Context.Session.GetString("Rol") == "admin")
                {
                    <div class="card-footer d-flex gap-2">
                        <a class="btn btn-warning btn-sm" href="/Producto/Edit/@item.Id">Editar</a>
                        <a class="btn btn-danger btn-sm" href="/Producto/Delete/@item.Id">Eliminar</a>
                    </div>
                }
            </div>
        </div>
    }
</div>