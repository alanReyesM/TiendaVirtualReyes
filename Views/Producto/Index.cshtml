@model List<TiendaVirtualReyes.Models.Producto>

<h2>Lista de Productos</h2>

@if (Context.Session.GetString("Rol") == "admin")
{
    <a class="btn btn-success mb-3" href="/Producto/Create">Nuevo Producto</a>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@item.ImagenUrl" class="card-img-top"
                     style="height: 200px; object-fit: cover;"
                     alt="@item.Nombre" />
                <div class="card-body">
                    <h5 class="card-title">@item.Nombre</h5>
                    <p class="card-text">
                        <strong>Precio:</strong> $@item.Precio <br />
                        <strong>Stock:</strong> @item.Stock <br />
                        <strong>Categoría:</strong> @item.Categoria?.Nombre
                    </p>
                </div>

                @if (Context.Session.GetString("Rol") == "admin")
                {
                    <div class="card-footer d-flex gap-2">
                        <a class="btn btn-warning btn-sm" href="/Producto/Edit/@item.Id">Editar</a>
                        <a class="btn btn-danger btn-sm" href="/Producto/Delete/@item.Id">Eliminar</a>
                    </div>
                }
            </div>
        </div>
    }
</div>